# Copier vers .env. Ne jamais commiter .env.
# Aucune de ces variables ne doit être préfixée par NEXT_PUBLIC_.

# Local : les deux peuvent être identiques.
# Supabase : DATABASE_URL = pooler (port 6543, ?pgbouncer=true&connection_limit=1).
# DIRECT_URL = connexion directe (port 5432), utilisée seulement par les migrations.
DATABASE_URL="postgresql://synapse:synapse@localhost:5433/synapse?schema=public"
DIRECT_URL="postgresql://synapse:synapse@localhost:5433/synapse?schema=public"

# Interdit : NEXT_PUBLIC_OPENAI_API_KEY, NEXT_PUBLIC_DATABASE_URL, NEXT_PUBLIC_AUTH_SECRET
OPENAI_API_KEY=""
# openssl rand -base64 32 — au moins 32 caractères. Jamais NEXT_PUBLIC_.
AUTH_SECRET=""

# Compte de démonstration local. Ne pas réutiliser en production.
DEMO_USER_EMAIL="demo@synapse.local"
DEMO_USER_PASSWORD=""
DEMO_USER_NAME="Infirmier démo"

# openai | fake — fake pendant le développement, aucun appel réseau
AI_PROVIDER="fake"
AI_TRANSCRIBE_MODEL=""
AI_CLINICAL_MODEL=""

# local | supabase
# local : fichiers dans /storage, hors de public/, ignoré par git.
# supabase : bucket privé, aucune URL publique. La clé service ne doit jamais être NEXT_PUBLIC_.
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="synapse-audio"
